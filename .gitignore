
# Paul exclusions
*.apk


# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Local analysis tools, captures and build output
.tools/
analysis/private/
analysis/generated/
tmp/
**/bin/
**/obj/
artifacts/
.vs/

# Interpreter caches from optional analysis helpers
__pycache__/
*.py[cod]
